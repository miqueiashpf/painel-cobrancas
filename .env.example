# Copie para .env.local (nunca faça commit do .env.local).
# Nenhuma variável usa o prefixo NEXT_PUBLIC_: o navegador não fala com o Supabase.

# Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
# Chave secreta: usada só no servidor para enviar convites e bloquear usuários.
SUPABASE_SERVICE_ROLE_KEY=

# Endereço público do site, sem barra no final (usado nos links dos e-mails).
SITE_URL=http://localhost:3000
